# Image-streaming (Riptide/GCFS) PoC demo. Same stateful counter app as the
# counter demo, but built by ko onto a large base image (see
# baseImageOverrides for demos/streaming/counterheavy in .ko.yaml) so there is
# a heavy rootfs that is STREAMED through the node's gcfs snapshotter at resume
# instead of pulled and unpacked. Requires:
#   * image streaming enabled on the node pool the workers run on
#   * atelet started with --image-streaming-poc=true
#   * registry read for the ate-demo-streaming/default workload identity
# See demos/streaming/README.md.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-streaming

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: streaming
  namespace: ate-demo-streaming
  labels:
    workload: streaming
spec:
  replicas: 5
  ateomImage: ko://github.com/agent-substrate/substrate/cmd/ateom-gvisor
  sandboxClass: gvisor
  # Pin workers to the dedicated streaming worker pool, so recreating those
  # nodes for cold-start measurements never disturbs the control plane (which
  # runs on the main pool). Create the pool with:
  #   gcloud container node-pools create streaming-workers --enable-image-streaming \
  #     --node-labels ate.dev/pool=streaming-workers ...
  template:
    nodeSelector:
      ate.dev/pool: streaming-workers
    # Tolerate the pool taint so only streaming workers (not control-plane
    # pods) land here — keeps the control plane on the main pool so cold-test
    # recreates of this pool never disturb it.
    tolerations:
    - key: ate.dev/pool
      operator: Equal
      value: streaming-workers
      effect: NoSchedule

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: counter-heavy
  namespace: ate-demo-streaming
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: counter
    # ko builds the counter server onto the large base from .ko.yaml and pins
    # the digest (ActorTemplate rule). command MUST be set explicitly because
    # the streaming path pulls no image config to derive the entrypoint from.
    image: ko://github.com/agent-substrate/substrate/demos/streaming/counterheavy
    command: ["/ko-app/counterheavy"]
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    - name: data
      mountPath: /home/counter
  workerSelector:
    matchLabels:
      workload: streaming
  snapshotsConfig:
    onPause: Full
    onCommit: Data
    location: gs://${BUCKET_NAME}/ate-demo-streaming/
  volumes:
  - name: data
    durableDir: {}
